# Backend (apps/api) — prefixed LISTENFLOW_
LISTENFLOW_ENV=development
# Ports match docker-compose.yml (host 15432 / 16379)
LISTENFLOW_DATABASE_URL=postgresql+psycopg://listenflow:listenflow@localhost:15432/listenflow
LISTENFLOW_REDIS_URL=redis://localhost:16379/0
LISTENFLOW_STORAGE_ROOT=./storage
LISTENFLOW_SECRET_KEY=change-me
# Job runner: eager (sync, blocks request) | thread (background thread) | dramatiq (redis worker)
LISTENFLOW_JOB_RUNNER=thread
# faster-whisper transcription
LISTENFLOW_WHISPER_MODEL=base.en
LISTENFLOW_WHISPER_DEVICE=cpu
LISTENFLOW_WHISPER_COMPUTE_TYPE=int8

# Zhipu LLM for keyword picking (https://open.bigmodel.cn/usercenter/apikeys).
# Leave empty to fall back to the naive stopword-based extractor.
LISTENFLOW_ZHIPU_API_KEY=
LISTENFLOW_ZHIPU_MODEL=glm-4-flash

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
